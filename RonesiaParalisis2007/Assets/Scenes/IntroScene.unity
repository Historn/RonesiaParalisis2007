  m_Name: 
  m_EditorClassIdentifier: 
  CurrentIDCounter: 52
  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":21}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":97.5004,\"yPos\":-1504.99341},\"ID\":19,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ah.
    Hola.\",\"parentUIDs\":[18],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":22}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":354.500244,\"yPos\":-1503.99341},\"ID\":20,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"S\xED,
    hombre...\",\"parentUIDs\":[18],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":25}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":96.5004,\"yPos\":-1209.99},\"ID\":23,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Eh...
    Oye, \xBFqu\xE9 hora es?\",\"parentUIDs\":[21,22],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":26}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":365.500244,\"yPos\":-1210.99},\"ID\":24,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xBFPero
    que me est\xE1s contando, t\xEDo?\",\"parentUIDs\":[21,22],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":31}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":59.5003967,\"yPos\":-659.989258},\"ID\":29,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ah.
    Vale.\",\"parentUIDs\":[28],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":32}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":381.500183,\"yPos\":-657.989258},\"ID\":30,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Eh...
    \xBFpero esto m\xE1s o menos cuanto va a tardar? Porque es que tengo una entrevista
    de trabajo a las 8.\",\"parentUIDs\":[28],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":37}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":61.6004028,\"yPos\":261.206543},\"ID\":36,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Guay,
    pues que vaya bien, t\xEDo.\",\"parentUIDs\":[42,46],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":37}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":286.000061,\"yPos\":256.40625},\"ID\":38,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xBFEntonces
    tiro recto o qu\xE9 hago?\",\"parentUIDs\":[42,46],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":42}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":343.000244,\"yPos\":-401.99},\"ID\":40,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ah,
    perd\xF3n, contin\xFAa.\",\"parentUIDs\":[32],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":43}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":573.9999,\"yPos\":-400.99},\"ID\":41,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"No,
    a ver, yo entiendo que ten\xE9is vuestras movidas aqu\xED pero es que si puedo
    acabar antes de las 8 me va mejor.\",\"parentUIDs\":[32],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":46}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":578.9999,\"yPos\":36.0063477},\"ID\":47,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Vale,
    tienes raz\xF3n. Perdona.\",\"parentUIDs\":[45],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":17}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":110.200012,\"yPos\":-1965},\"ID\":49,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ualaaa...\",\"parentUIDs\":[15],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":17}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":343,\"yPos\":-1965.59985},\"ID\":50,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Hostiaaa...\",\"parentUIDs\":[15],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":13}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":232,\"yPos\":-2521},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ramiro
    se toca el pecho, los brazos, la cabeza y las piernas. Todo parece estar en su
    sitio.  El viento acaricia las briznas de hierba, trayendo consigo una cantinela
    evocativa de recuerdos que ni siquiera tuvo.\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":true,\"IconGUID\":null,\"Name\":\"Narrador\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.1,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":14}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":232.499939,\"yPos\":-2367.99854},\"ID\":13,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Abre
    ligeramente los ojos, y el sol le ciega. No recuerda que en su cuarto haya tanta
    luz.\",\"parentUIDs\":[0],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Narrador\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":15}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":237.499878,\"yPos\":-2223.99561},\"ID\":14,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Mira
    a su alrededor, y ve un bosque frondoso, con \xE1rboles de proporciones fant\xE1sticas,
    vibrantes, maravillosos. Hay una vasta pradera en la lejan\xEDa, rebosante de
    criaturillas retozando en harmon\xEDa.\",\"parentUIDs\":[13],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Narrador\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":49},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":50}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":231.5,\"yPos\":-2085.996},\"ID\":15,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Entonces,
    se da cuenta de que no est\xE1 en su cuarto.\",\"parentUIDs\":[14],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Narrador\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":18}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":235.399963,\"yPos\":-1777.59546},\"ID\":17,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Parece
    que Ramiro lo va a tener complicado. \\r\\n\\r\\nMientras est\xE1 inspeccionando
    el entorno, totalmente convencido de que a\xFAn debe seguir durmiendo, una figura
    encapuchada aparece detr\xE1s de \xE9l, anunciando grandiosamente su presencia.\",\"parentUIDs\":[49,50],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Narrador\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":19},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":20}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":238.999939,\"yPos\":-1654.99463},\"ID\":18,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ramiro
    Casimiro, hijo de Alfonso y Mercedes! \xD3yeme! Y \xF3yeme bien! Pues mi palabra
    es el evangelio de la verdad en esta tierra de fantas\xEDa!\",\"parentUIDs\":[17],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Certerus,
    el inescrutable\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":23},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":24}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":103.5004,\"yPos\":-1399.99292},\"ID\":21,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Hola.
    Viajero, yo soy el gran mago Certerus, el Inescrutable! Yo ser\xE9 aquel que
    pondr\xE1 luz en la oscuridad cuando m\xE1s perdido te halles. La estrella polar
    de \xE9sta, tu aventura en el legendario contintente de Ronesia! Donde los campos
    son f\xE9rtiles, las flores rosas y la cerveza roja.\",\"parentUIDs\":[19],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Certerus,
    el inescrutable\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":23},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":24}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":355.500183,\"yPos\":-1399.99316},\"ID\":22,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"No
    dejes que tu mente te enga\xF1e, viajero. Todo lo que ves ante t\xED es tan real
    como la vida misma, puesto que lo digo yo, el gran mago Certerus, el Inescrutable!
    Yo ser\xE9 aquel que pondr\xE1 luz en la oscuridad cuando m\xE1s perdido te halles.
    La estrella polar de \xE9sta, tu aventura en el legendario contintente de Ronesia!
    Donde los campos son f\xE9rtiles, las flores rosas y la cerveza roja.\",\"parentUIDs\":[20],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Certerus,
    el inescrutable\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":27}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":91.5004,\"yPos\":-1106.99072},\"ID\":25,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Silencio,
    viajero! Ahora es el momento de escuchar. Pues t\xFA aventura por estos lares
    no ha hecho m\xE1s que empezar...\",\"parentUIDs\":[23],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Certerus,
    el inescrutable\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":27}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":366.500244,\"yPos\":-1103.99072},\"ID\":26,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Te
    estoy contando cu\xE1l es tu predestinado cometido por estos lares, \\\"t\xEDo\\\".
    Pues t\xFA aventura no ha hecho m\xE1s que empezar...\",\"parentUIDs\":[24],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Certerus,
    el inescrutable\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":28}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":235.499939,\"yPos\":-957.9907},\"ID\":27,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"A
    partir de aqu\xED, Certerus adquiere un tono solemne.\",\"parentUIDs\":[25,26],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Narrador\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":29},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":30}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":234.499939,\"yPos\":-823.990234},\"ID\":28,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"En
    este lugar conviven dos pueblos ancestrales, tan antiguos como la tierra a tus
    pies... Estos dos pueblos, viajero... est\xE1n al borde de una catastr\xF3fica
    guerra. Este mundo podr\xEDa pronto colapsar sobre sus propios fundamentos. Precisa
    de un catalizador, una fuerza de bien inquebrantable, un agente de cambio capaz
    de acabar con este conflicto milenario y traer paz de una vez por todas... Solo
    as\xED, el h\xE9roe puro de coraz\xF3n podr\xE1 retornar a casa.\",\"parentUIDs\":[27],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Certerus\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":34}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":58.5003967,\"yPos\":-526.9895},\"ID\":31,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ah.
    \xBFS\xED? Vale. Estupendo. Pues... Eh...\",\"parentUIDs\":[29],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Certerus\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":40},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":41}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":383.500183,\"yPos\":-527.9895},\"ID\":32,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Entrevista
    de- \xBFComprendes que el futuro de esta, nuestra Ronesia est\xE1 en tus manos?
    \xBFLos centenares de miles de vidas que hay en riesgo? \xA1No hay tiempo para
    entrevistas! \xBFComo vas a-? A ver, \xBFQu\xE9 entrevista? \xBFQu\xE9 dices?\",\"parentUIDs\":[30],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Certerus\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":35}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":56.0003662,\"yPos\":-388.989746},\"ID\":34,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Certerus
    se frota la sien haciendo como que esta reflexionando pero es que en realidad
    no esperaba que Ramiro aceptase tan r\xE1pido. \",\"parentUIDs\":[31],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Narrador\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":42}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":53.8003845,\"yPos\":-247.991943},\"ID\":35,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Tu
    aventura... Comienza... En...\\n\\nPara llegar a la tierra de los hombres, sigue
    el humo negro. Para llegar a la tierra de los druidas, sigue el camino del bosque.
    T\xFA no encuentras la villa, la villa te encontrar\xE1 a ti...\",\"parentUIDs\":[34],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Certerus\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":170.400452,\"yPos\":375.205078},\"ID\":37,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"El
    misterioso mago se desvanece en una nube de humo blanco. Ramiro nota un ligero
    aroma a fresa.\",\"parentUIDs\":[36,38],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Narrador\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":36},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":38}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":46.80005,\"yPos\":123.407959},\"ID\":42,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ehem...
    Para llegar a la tierra de los hombres, sigue el humo negro. Para llegar a la
    tierra de los druidas, sigue el camino del bosque. T\xFA no encuentras la villa,
    la villa te encontrar\xE1 a ti...\",\"parentUIDs\":[35,40],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Certerus\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":44}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":584.000366,\"yPos\":-300.990967},\"ID\":43,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Bueno,
    ya veremos.\",\"parentUIDs\":[41],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Certerus\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":45}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":577.9999,\"yPos\":-193.992188},\"ID\":44,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Certerus
    se recompone un poco porque se le est\xE1 yendo la voz de mago.\",\"parentUIDs\":[43],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Narrador\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":47}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":579.999756,\"yPos\":-75.99365},\"ID\":45,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ehem...
    La hora de retorno no es la mayor preocupaci\xF3n en este instante. \xBFVale?\",\"parentUIDs\":[44],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Certerus\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":38},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":36}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":563.9999,\"yPos\":158.006348},\"ID\":46,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"En
    fin... Para llegar a la tierra de los hombres, sigue el humo negro. Para llegar
    a la tierra de los druidas, sigue el camino del bosque. T\xFA no encuentras la
    villa, la villa te encontrar\xE1 a ti...\",\"parentUIDs\":[47],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Certerus\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
